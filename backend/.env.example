PORT=3000
DATABASE_URL=arcade.db
PUBLIC_BASE_URL=http://localhost:3000

# Credencial do tipo "Aplicativo da Web" criada no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mails Google que terão acesso administrativo, separados por vírgulas.
ADMIN_EMAILS=

# Opcional. Se omitida, será PUBLIC_BASE_URL + /api/auth/callback.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
