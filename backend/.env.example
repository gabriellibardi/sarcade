PORT=3000
DATABASE_URL=arcade.db
PUBLIC_BASE_URL=http://localhost:3000

# Credencial do tipo "Aplicativo da Web" criada no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mails Google que terão acesso administrativo, separados por vírgulas.
ADMIN_EMAILS=

# Binário Sgleam com suporte ao protocolo Sinteract por fd 3/fd 4.
# Em releases autocontidos ele já vem incorporado; use esta variável somente
# para substituí-lo explicitamente durante o desenvolvimento.
SGLEAM_EXECUTABLE=

# Limite compartilhado por partidas e inspeções (faixa aceita: 1 a 256).
MAX_RUNTIME_PROCESSES=32
